FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend:/app \
    HOME=/tmp

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-common.txt requirements-dashboard.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-dashboard.txt

COPY backend ./backend

RUN groupadd --system --gid 10001 seo-sensei \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin seo-sensei \
    && chown -R seo-sensei:seo-sensei /app /opt/venv

USER seo-sensei

EXPOSE 8501

CMD ["sh", "-c", "exec streamlit run backend/dashboard.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --server.headless true --browser.gatherUsageStats false"]
