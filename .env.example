# SEO-Sensei environment configuration. Replace placeholders locally/deployment-side.
APP_ENV=development
GEMINI_API_KEY=replace-with-server-side-key
ALLOWED_CORS_ORIGINS=http://localhost:8501
API_ACCESS_TOKEN=replace-with-demo-token
CORS_ALLOW_CREDENTIALS=false
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_SIZE_BYTES=1000000
MAX_CRAWL_RESPONSE_SIZE_BYTES=2000000
MAX_REDIRECTS=3
MAX_FETCH_CONNECTIONS=10
MAX_FETCH_KEEPALIVE_CONNECTIONS=5
MAX_URL_LENGTH=2048
MAX_TOPIC_LENGTH=500
MAX_KEYWORD_COUNT=20
MAX_KEYWORD_LENGTH=80
MAX_AI_INPUT_SIZE=30000
MAX_AI_OUTPUT_SIZE=50000
AI_REQUEST_TIMEOUT_SECONDS=20
AI_RETRY_COUNT=1
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_CONCURRENCY=3
MAX_AI_RECOMMENDATION_COUNT=5
MAX_AI_RECOMMENDATION_LENGTH=1000
