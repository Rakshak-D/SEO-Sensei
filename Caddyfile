{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode gzip zstd
	# Application URLs may contain user search/filter state. Keep request URLs,
	# cookies, CSRF values, and analysis payloads out of app-domain access logs.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
		Cache-Control "no-store"
	}
	route {
		@browser_api path /api/browser/v1 /api/browser/v1/*
		handle @browser_api {
			request_body {
				max_size 8KB
			}
			header Cache-Control "no-store"
			reverse_proxy api:8000
		}

		@api_path path /api/*
		handle @api_path {
			respond "Not found." 404
		}

		handle {
			root * /srv
			@hashed_assets path /assets/*
			header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}

{$API_DOMAIN} {
	encode gzip zstd
	@browser_api path /api/browser/v1*
	handle @browser_api {
		respond "Not found." 404
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	log {
		output stdout
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-CSRF-Token delete
			request>uri query {
				delete token
				delete url
				delete csrf_token
			}
		}
	}
}
