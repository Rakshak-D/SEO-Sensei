FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-common.txt requirements-api.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-api.txt

COPY backend ./backend

RUN groupadd --system --gid 10001 seo-sensei \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin seo-sensei \
    && chown -R seo-sensei:seo-sensei /app /opt/venv

USER seo-sensei

EXPOSE 8000

CMD ["sh", "-c", "exec python -m uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
