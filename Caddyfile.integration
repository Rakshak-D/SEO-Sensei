{
	admin off
}

https://seo-sensei.localhost:8443 {
	tls internal
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
		Cache-Control "no-store"
	}
	route {
		@browser_api path /api/browser/v1 /api/browser/v1/*
		handle @browser_api {
			request_body {
				max_size 8KB
			}
			header Cache-Control "no-store"
			reverse_proxy api:8000
		}
		@api_path path /api/*
		handle @api_path {
			respond "Not found." 404
		}
		handle {
			root * /srv
			@hashed_assets path /assets/*
			header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}

https://seo-sensei-api.localhost:8443 {
	tls internal
	@browser_api path /api/browser/v1*
	handle @browser_api {
		respond "Not found." 404
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}
}
