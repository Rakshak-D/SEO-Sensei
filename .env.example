# SEO-Sensei environment configuration. Replace placeholders locally/deployment-side.
APP_ENV=development
# Compose uses CONTAINER_APP_ENV so local non-container development can remain development-only.
CONTAINER_APP_ENV=production
GEMINI_API_KEY=
# For production use the real dashboard origin and configured extension origin.
ALLOWED_CORS_ORIGINS=https://app.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
TRUSTED_PROXY_NETWORKS=172.30.0.2/32
API_ACCESS_TOKEN=replace-with-demo-token
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_API_ACCESS_TOKEN=replace-with-dashboard-token
API_CONTAINER_PORT=8000
DASHBOARD_CONTAINER_PORT=8501
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000
DASHBOARD_HOST_BIND=127.0.0.1
DASHBOARD_HOST_PORT=8501
CORS_ALLOW_CREDENTIALS=false
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_SIZE_BYTES=1000000
MAX_CRAWL_RESPONSE_SIZE_BYTES=2000000
MAX_REDIRECTS=3
MAX_FETCH_CONNECTIONS=10
MAX_FETCH_KEEPALIVE_CONNECTIONS=5
MAX_URL_LENGTH=2048
MAX_TOPIC_LENGTH=500
MAX_KEYWORD_COUNT=20
MAX_KEYWORD_LENGTH=80
MAX_AI_INPUT_SIZE=30000
MAX_AI_OUTPUT_SIZE=50000
AI_REQUEST_TIMEOUT_SECONDS=20
AI_RETRY_COUNT=1
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_CONCURRENCY=3
MAX_AI_RECOMMENDATION_COUNT=5
MAX_AI_RECOMMENDATION_LENGTH=1000
ANALYSIS_RATE_LIMIT_PER_MINUTE=30
ANALYSIS_RATE_LIMIT_PER_HOUR=300
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
ARTICLE_RATE_LIMIT_PER_MINUTE=3
ARTICLE_RATE_LIMIT_PER_HOUR=20
BOOST_RATE_LIMIT_PER_MINUTE=5
BOOST_RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_MAX_KEYS=10000
